<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Contour Config" Manufacturer="pfjordside" Version="!(bind.FileVersion.MainExe)"
           UpgradeCode="6F0D5B2E-3C41-4E8A-9B7C-2A1D4E5F6071" Scope="perUser" Compressed="yes">
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Contour Config is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/pfjordside/contour-config" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="ContourConfig" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable">
        <File Id="MainExe" Source="$(AppPublishDir)ContourConfig.App.exe" />
      </Component>
      <Component Id="StartMenuEntry">
        <Shortcut Target="[INSTALLFOLDER]ContourConfig.App.exe" Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Contour Config"
                  Description="RollerMouse end-drift booster" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\ContourConfig" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Files Include="$(AppPublishDir)**">
        <Exclude Files="$(AppPublishDir)ContourConfig.App.exe" />
        <Exclude Files="$(AppPublishDir)**.pdb" />
      </Files>
    </ComponentGroup>

    <Feature Id="Main" Title="Contour Config">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

    <!-- Close a running copy (it is often minimized in the background) before files are replaced or removed. -->
    <util:CloseApplication Id="CloseRunningApp" Target="ContourConfig.App.exe" CloseMessage="yes" RebootPrompt="no" />

    <!-- On uninstall, remove the "Start with Windows" entry the app may have written. -->
    <CustomAction Id="UnregisterStartup" FileRef="MainExe" ExeCommand="--unregister-startup"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="UnregisterStartup" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- Wizard: Welcome, install folder, install, finish (with an optional launch checkbox). No license page. -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Contour Config" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#MainExe]" />
    <CustomAction Id="LaunchApp" DllEntry="WixShellExec" BinaryRef="Wix4UtilCA_X64" Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_InstallDir" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Package>
</Wix>
